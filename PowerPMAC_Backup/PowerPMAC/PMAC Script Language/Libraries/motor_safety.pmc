open subprog MotorSafetyCheck(MtrNum, CurPos, MinLimit, MaxLimit, SafeMin, SafeMax)

    // 1. 检查是否越界
    if (CurPos > MaxLimit || CurPos < MinLimit) {
        
        // 2. 紧急切断动力 (保护机械结构和电机)
        cmd "#%d k", MtrNum; 
        
        // 3. 软恢复逻辑 (退回安全区间)
        if (CurPos > MaxLimit) {
            // 注意：先发送 j/ 让电机重新闭环上电，然后再发 j= 走绝对位置
            cmd "#%d j/ j=%d", MtrNum, SafeMax; 
        }
        if (CurPos < MinLimit) {
            cmd "#%d j/ j=%d", MtrNum, SafeMin;
        }
        
        // 【注】这里绝对不能用 call wait()。
        // 电机接到指令后会自己按设定的速度退回安全位置，
        // PLC 执行完这行应该立刻退出，去检查下一个电机！
    }
close