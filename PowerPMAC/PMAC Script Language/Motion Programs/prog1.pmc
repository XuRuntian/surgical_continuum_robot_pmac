&1 
#1->X
#2->Y
#3->Z
#4->A
#5->B

open prog 1
local target_t;
local p_inc1, p_inc2, p_inc3, p_inc4, p_inc5;
local last_p1, last_p2, last_p3, last_p4, last_p5; // 新增：记录上一次的目标点
local r_base; 
local run_state = 0; // 0: 蓄水期, 1: 放水期
PVT_WriteIdx = 0;
PVT_ReadIdx = 0;
PVT_Count = 0;
run_state = 0;

// 顺手把 PLC 的触发信号强行按死，防止旧信号作祟
Sys.ModbusServerBuffer[400] = 0;
Sys.ModbusServerBuffer[401] = 0;
abs
linear
inc

// 【关键】：进入循环前，以当前物理位置作为起点基准
last_p1 = Motor[1].Pos;
last_p2 = Motor[2].Pos;
last_p3 = Motor[3].Pos;
last_p4 = Motor[4].Pos;
last_p5 = Motor[5].Pos;

while (1) {
    PVT_Count = PVT_WriteIdx - PVT_ReadIdx;
    if (PVT_Count < 0) { PVT_Count = PVT_Count + PVT_BufferSize; }

    // ==========================================
    // 状态 0：蓄水缓冲 (攒够 3 个点再发车)
    // ==========================================
    if (run_state == 0) {
        if (PVT_Count >= 10) {
            run_state = 1;
            // 重新同步起点（防止蓄水期间被人手推动）
            last_p1 = Motor[1].Pos;
            last_p2 = Motor[2].Pos;
            last_p3 = Motor[3].Pos;
            last_p4 = Motor[4].Pos;
            last_p5 = Motor[5].Pos;
        } else {
            PVT (10) 
            X (0):0 Y (0):0 Z (0):0 A (0):0 B (0):0
        }
    }

    // ==========================================
    // 状态 1：平滑运行
    // ==========================================
    if (run_state == 1) {
        if (PVT_Count > 0) {
            r_base = PVT_ReadIdx * 6;
            target_t = PVT_Time(PVT_ReadIdx);
            
            // 安全保护
            if (target_t <= 5) { target_t = 10; } 
            if (target_t > 500) { target_t = 500; } 

            // 【核心修复】：纯数学计算目标差值，切断物理误差反馈！
            p_inc1 = PVT_Pos(r_base + 1) - last_p1;
            p_inc2 = PVT_Pos(r_base + 2) - last_p2;
            p_inc3 = PVT_Pos(r_base + 3) - last_p3;
            p_inc4 = PVT_Pos(r_base + 4) - last_p4;
            p_inc5 = PVT_Pos(r_base + 5) - last_p5;

            // 更新最后目标点为当前点，为下一个循环做准备
            last_p1 = PVT_Pos(r_base + 1);
            last_p2 = PVT_Pos(r_base + 2);
            last_p3 = PVT_Pos(r_base + 3);
            last_p4 = PVT_Pos(r_base + 4);
            last_p5 = PVT_Pos(r_base + 5);

            // 执行相对 PVT 插补
            PVT (target_t)
            X (p_inc1):(PVT_Vel(r_base + 1)) Y (p_inc2):(PVT_Vel(r_base + 2)) Z (p_inc3):(PVT_Vel(r_base + 3)) A (p_inc4):(PVT_Vel(r_base + 4)) B (p_inc5):(PVT_Vel(r_base + 5))

            PVT_ReadIdx++;
            if (PVT_ReadIdx >= PVT_BufferSize) { PVT_ReadIdx = 0; }
        } else {
            // 断流保护
            run_state = 0;
            PVT (20) 
            X (0):0 Y (0):0 Z (0):0 A (0):0 B (0):0
        }
    }
}
close