ECAT[0].IO[3].Data = 8
ECAT[0].IO[7].Data = 8
ECAT[0].IO[11].Data = 8
ECAT[0].IO[15].Data = 8
ECAT[0].IO[19].Data = 8

// =========================================================
// [数据层]: PVT 环形缓冲区 (高内聚：所有轨迹数据集中管理)
// =========================================================

// --- 缓冲区管理 ---
global PVT_BufferSize = 100;     // 水池最大深度
global PVT_WriteIdx = 0;         // 生产者(PLC) 写入指针 (0-99)
global PVT_ReadIdx = 0;          // 消费者(PROG) 读取指针 (0-99)
global PVT_Count = 0;            // 当前水池中可用的点数 (水位)

// --- 数据解码配置 ---
global PVT_Scale = 10000.0;      // Python 端放大的倍数，用于还原浮点数

// --- 轨迹数据数组 ---
// 使用一维数组存储时间，二维数组存储多轴位置与速度
global PVT_Time(100);            // 存储 T (时间，单位：毫秒)
global PVT_Pos(600);          // 存储 P (索引0-99，支持最多5个轴，保留第0位不用)
global PVT_Vel(600);          // 存储 V (速度)


//最大速度设置 ct/ms
Motor[1].MaxSpeed=8000
Motor[2].MaxSpeed=8000
Motor[3].MaxSpeed=8000
Motor[4].MaxSpeed=8000
//最大加速度设置，注意是倒数ms^2/ct
Motor[1].InvAmax=0.01
Motor[2].InvAmax=0.01
Motor[3].InvAmax=0.01
Motor[4].InvAmax=0.01
//最大减速度设置ms^2/ct
Motor[1].InvDmax=0.01
Motor[2].InvDmax=0.01
Motor[3].InvDmax=0.01
Motor[4].InvDmax=0.01
//最大加加速度设置ms^3/ct
Motor[1].InvDmax=0.05
Motor[2].InvDmax=0.05
Motor[3].InvDmax=0.05
Motor[4].InvJmax=0.05

Motor[1].JogSpeed = 3500
Motor[2].JogSpeed = 3500
Motor[3].JogSpeed = 3500
Motor[4].JogSpeed = 3500

// 设定 Jog 加速时间
Motor[1].JogTa = 50
Motor[2].JogTa = 50
Motor[3].JogTa = 50
Motor[4].JogTa = 50
// 设定 S型平滑时间
Motor[1].JogTs = 30
Motor[2].JogTs = 30
Motor[3].JogTs = 30
Motor[4].JogTs = 30
// 直线单元限制
Motor[5].JogTa = 20
Motor[5].JogSpeed = 200


// 
global target_pos1
global target_pos2
global target_pos3
global target_pos4
global target_pos5

// 动态速度（移动时间）与加速度参数
global target_move_time = 100  // 控制走完这段路程需要的时间 (ms)
global target_accel_time = 100 // 控制加减速的平滑时间 (ms)
global target_scurve_time = 50// S型曲线平滑时间

global MyInit_Flag = 0