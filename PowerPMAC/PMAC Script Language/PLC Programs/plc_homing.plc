// Commands: 1=start, 2=stop for confirmation, 3=set zero, 4=cancel.
// State: 0=idle, 1=arming, 2=jogging, 3=stopped, 4=waiting for zero.
// Snapshot/status encoding is owned by PLC 2 (Buffer 444,448,452,456,460).
open plc 3
local command_code;
local pos_diff;

call ModbusCodec.Decode(440);
command_code = P1001;

if (command_code == 1 && Homing_State == 0) {
    call SystemInit.StopPVT();
    Homing_State = 1;
    Homing_Done = 0;
    Homing_Stop_Reason = 0;
    Homing_SavedMaxDac = Motor[5].MaxDac;
    Homing_LimitActive = 1;
    if (Motor[5].MaxDac > 4000) { Motor[5].MaxDac = 4000; }
    cmd "#5j/";
    Homing_Timer = Sys.Time;
    Homing_LastClientTime = Sys.Time;
}

// Handle stop/cancel before the delayed jog branch, including during arming.
if (command_code == 2 || command_code == 4) {
    call SystemInit.StopPVT();
    cmd "#5k";
    call SystemInit.RestoreHomingLimit();
    Homing_Done = 0;
    Homing_Stop_Reason = 9;
    Homing_State = 3;
    if (command_code == 4) { Homing_State = 0; }
}

if (Homing_State == 1 || Homing_State == 2) {
    pos_diff = abs(Motor[5].DesPos - Motor[5].ActPos);
    if (pos_diff > 20000) { Homing_Stop_Reason = 2; }
    if (Sys.Time - Homing_LastClientTime > Homing_WatchdogSeconds) { Homing_Stop_Reason = 8; }
    if (Homing_Stop_Reason > 0) {
        cmd "#5k";
        call SystemInit.RestoreHomingLimit();
        Homing_State = 3;
    }
}

if (Homing_State == 1 && Sys.Time - Homing_Timer > 0.2) {
    cmd "#5j-";
    Homing_State = 2;
}

if (command_code == 3 && Homing_State == 3) {
    cmd "#5hmz";
    call SystemInit.RestoreHomingLimit();
    Homing_Done = 0;
    Homing_State = 4;
    Homing_Timer = Sys.Time;
}

if (Homing_State == 4 && Sys.Time - Homing_Timer > 0.05) {
    if (abs(Motor[5].Pos) < 1) {
        Homing_Done = 1;
        Homing_State = 0;
    } else if (Sys.Time - Homing_Timer > 2) {
        Homing_Stop_Reason = 10;
        Homing_State = 3;
    }
}
// Consume each command once, including invalid state/command combinations.
if (command_code != 0) { call ModbusCodec.Encode(0, 440); }
close
