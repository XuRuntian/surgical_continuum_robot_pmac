open plc 2
local IsNewData;
local base; // 用于存储当前点的基础索引

call ModbusCodec.Decode(200); 
IsNewData = P1001;

if (IsNewData > 0) {
    // 计算当前点的起始偏移 (例如 WriteIdx=1 时，base=6)
    base = PVT_WriteIdx * 6;

    call ModbusCodec.Decode(40);
    PVT_Time(PVT_WriteIdx) = P1001 / PVT_Scale;

    // 存储 5 轴位置 (P) - 对应索引 base + 1 到 base + 5[cite: 4]
    call ModbusCodec.Decode(0);  PVT_Pos(base + 1) = P1001 / PVT_Scale;
    call ModbusCodec.Decode(4);  PVT_Pos(base + 2) = P1001 / PVT_Scale;
    call ModbusCodec.Decode(8);  PVT_Pos(base + 3) = P1001 / PVT_Scale;
    call ModbusCodec.Decode(12); PVT_Pos(base + 4) = P1001 / PVT_Scale;
    call ModbusCodec.Decode(16); PVT_Pos(base + 5) = P1001 / PVT_Scale;

    // 存储 5 轴速度 (V)[cite: 4]
    call ModbusCodec.Decode(50); PVT_Vel(base + 1) = P1001 / PVT_Scale;
    call ModbusCodec.Decode(54); PVT_Vel(base + 2) = P1001 / PVT_Scale;
    call ModbusCodec.Decode(58); PVT_Vel(base + 3) = P1001 / PVT_Scale;
    call ModbusCodec.Decode(62); PVT_Vel(base + 4) = P1001 / PVT_Scale;
    call ModbusCodec.Decode(66); PVT_Vel(base + 5) = P1001 / PVT_Scale;

    PVT_WriteIdx++;
    if (PVT_WriteIdx >= PVT_BufferSize) { PVT_WriteIdx = 0; }
    
    PVT_Count = PVT_WriteIdx - PVT_ReadIdx;
    if (PVT_Count < 0) { PVT_Count = PVT_Count + PVT_BufferSize; }

    Sys.ModbusServerBuffer[200] = 0;
    Sys.ModbusServerBuffer[201] = 0;
    Sys.ModbusServerBuffer[202] = 0;
    Sys.ModbusServerBuffer[203] = 0;
}
close