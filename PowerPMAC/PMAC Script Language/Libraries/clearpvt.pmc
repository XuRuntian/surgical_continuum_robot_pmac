// Protocol v2 lifecycle. Reset leaves PVT stopped until Python captures feedback.
open subprog SystemInit

sub: StopPVT()
    PVT_Ready = 0;
    PVT_HasData = 0;
    cmd "&1A";
    PVT_WriteIdx = 0;
    PVT_ReadIdx = 0;
    PVT_Count = 0;
return

sub: RestoreHomingLimit()
    if (Homing_LimitActive == 1) {
        Motor[5].MaxDac = Homing_SavedMaxDac;
        Homing_LimitActive = 0;
    }
return

sub: Reset()
    // Preserve PLC 1's existing enable state and its calibration settings.
    cmd "disable plc 2,3";
    Reset_Done = 0;
    call ModbusCodec.Encode(0, 432);
    call wait(1);
    call SystemInit.StopPVT();
    cmd "#1..5k";
    call wait(1);
    call SystemInit.RestoreHomingLimit();
    Homing_State = 0;
    Homing_Done = 0;
    Homing_Stop_Reason = 0;
    PVT_Ack = 0;
    PVT_Overflow = 0;
    PVT_Faulted = 0;
    Feedback_Ack = 0;
    call ModbusCodec.Encode(0, 400);
    call ModbusCodec.Encode(0, 404);
    call ModbusCodec.Encode(0, 408);
    call ModbusCodec.Encode(0, 412);
    call ModbusCodec.Encode(0, 416);
    call ModbusCodec.Encode(0, 420);
    call ModbusCodec.Encode(2, 424);
    call ModbusCodec.Encode(0, 428);
    call ModbusCodec.Encode(0, 440);
    call ModbusCodec.Encode(Axis5_MaxStep, 436);
    cmd "#1..5j/";
    call wait(1);
    cmd "&1 #1->X #2->Y #3->Z #4->A #5->B";
    cmd "enable plc 2,3";
    Reset_Done = 1;
    call ModbusCodec.Encode(Reset_Done, 432);
return

close
